# Copy to .env.local for the Next.js app. Values below are empty or fake.
# Never put a real key in this file.

# Supabase project this slice reads and writes (your own project, not production).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Edge function money-guard (Supabase injects SUPABASE_URL and the service role at runtime).
SUPABASE_URL=https://your-project-ref.supabase.co

# Meta Graph credentials used only by the money-guard function. The Next.js app does not call Meta.
META_ACCESS_TOKEN=
META_APP_SECRET=

# Shared secret for POST /money-guard (header x-guard-key). Example only.
MONEY_GUARD_KEY=changeme
